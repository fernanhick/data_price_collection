{
  "name": "sneaker-price-api",
  "version": "0.1.0",
  "description": "Backend API for aggregating sneaker market prices",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:generate-jwt": "tsx scripts/generate-test-jwt.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:bulk-import": "tsx src/scripts/bulk-import-sneakers.ts",
    "sneaker:discover": "tsx src/scripts/discover-sneakers.ts",
    "sneaker:discover-safe": "tsx src/scripts/discover-sneakers-safe.ts",
    "sneaker:discover-mega": "tsx src/scripts/discover-sneakers-mega.ts",
    "discover:comprehensive": "tsx src/scripts/discover-sneakers-comprehensive.ts",
    "discover:by-brand": "tsx src/scripts/discover-sneakers-by-brand.ts",
    "discovery:full": "tsx src/scripts/full-discovery-with-prices.ts",
    "sneaker:kicksdb": "tsx src/scripts/bulk-fetch-kicksdb.ts",
    "sneaker:kicksdb-all": "tsx src/scripts/fetch-all-kicksdb.ts",
    "sneaker:kicksdb-backfill": "tsx src/scripts/backfill-kicksdb-data.ts",
    "images:backfill": "tsx src/scripts/backfill-images.ts",
    "images:backfill-batch": "tsx src/scripts/backfill-images-batch.ts",
    "prices:fetch": "tsx src/scripts/fetch-prices-manual.ts",
    "ecmv:backfill": "tsx src/scripts/backfill-price-history.ts",
    "scraper:test": "tsx src/scripts/test-scraper.ts",
    "scraper:test-stylecode": "tsx src/scripts/test-stylecode.ts",
    "admin:create-user": "tsx scripts/create-admin-user.ts",
    "migrate:backup": "bash scripts/migrate-to-vps.sh"
  },
  "keywords": [
    "sneaker",
    "price",
    "api",
    "scraper"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.991.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.2",
    "pg": "^8.10.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.2.3",
    "puppeteer": "^24.36.1",
    "redis": "^4.6.0",
    "sharp": "^0.34.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.0",
    "@types/node-cron": "^3.0.8",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
