{
  "name": "sneaker-price-api",
  "version": "0.1.0",
  "description": "Backend API for aggregating sneaker market prices",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-esm src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "db:migrate": "ts-node-esm src/scripts/migrate.ts",
    "db:seed": "ts-node-esm src/scripts/seed.ts",
    "scraper:test": "ts-node-esm src/scripts/test-scraper.ts"
  },
  "keywords": ["sneaker", "price", "api", "scraper"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0",
    "pg": "^8.10.0",
    "redis": "^4.6.0",
    "node-cron": "^3.0.2",
    "jsonwebtoken": "^9.1.0",
    "zod": "^3.22.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.2.3",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.10.9",
    "@types/node-cron": "^3.0.8",
    "@types/jest": "^29.5.8",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.1",
    "ts-node-esm": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "prettier": "^3.1.1"
  }
}
