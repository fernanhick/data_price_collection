{
  "name": "sneaker-price-api",
  "version": "0.1.0",
  "description": "Backend API for aggregating sneaker market prices",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:generate-jwt": "tsx scripts/generate-test-jwt.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "admin:create-user": "tsx scripts/create-admin-user.ts",
    "migrate:backup": "bash scripts/migrate-to-vps.sh",

    "--- DATABASE ---": "",
    "db:migrate": "tsx src/scripts/db.ts migrate",
    "db:seed": "tsx src/scripts/db.ts seed",
    "db:bulk-import": "tsx src/scripts/import.ts",

    "--- DISCOVERY ---": "",
    "discover": "tsx src/scripts/discover.ts",
    "discover:safe": "tsx src/scripts/discover.ts --preset safe",
    "discover:mega": "tsx src/scripts/discover.ts --preset mega",
    "discover:full": "tsx src/scripts/discover.ts --preset mega --with-prices",

    "--- PRICES ---": "",
    "prices": "tsx src/scripts/prices.ts",
    "prices:all": "tsx src/scripts/prices.ts --all",
    "prices:fast": "tsx src/scripts/prices.ts --all --skip-stockx",

    "--- RELEASES ---": "",
    "releases:refresh": "tsx src/services/releases/upcomingReleases.ts",
    "releases:seed": "tsx src/scripts/seedReleases.ts",

    "--- IMAGES ---": "",
    "images": "tsx src/scripts/images.ts",
    "images:all": "tsx src/scripts/images.ts --iterations 11",

    "--- KICKSDB ---": "",
    "kicksdb": "tsx src/scripts/kicksdb.ts",
    "kicksdb:all": "tsx src/scripts/kicksdb.ts --all",

    "--- ECMV & CLEANUP ---": "",
    "ecmv": "tsx src/scripts/ecmv.ts",
    "cleanup": "tsx src/scripts/cleanup.ts",

    "--- TESTS ---": "",
    "test:scrapers": "tsx src/scripts/test.ts --suite scraper",
    "test:all": "tsx src/scripts/test.ts --suite all",

    "--- EC2 SCRIPTS (prefix any script with DB_TARGET=ec2) ---": "",
    "ec2:discover": "DB_TARGET=ec2 tsx src/scripts/discover.ts",
    "ec2:discover:safe": "DB_TARGET=ec2 tsx src/scripts/discover.ts --preset safe",
    "ec2:discover:mega": "DB_TARGET=ec2 tsx src/scripts/discover.ts --preset mega",
    "ec2:discover:full": "DB_TARGET=ec2 tsx src/scripts/discover.ts --preset mega --with-prices",
    "ec2:prices": "DB_TARGET=ec2 tsx src/scripts/prices.ts",
    "ec2:prices:all": "DB_TARGET=ec2 tsx src/scripts/prices.ts --all",
    "ec2:prices:fast": "DB_TARGET=ec2 tsx src/scripts/prices.ts --all --skip-stockx",
    "ec2:images": "DB_TARGET=ec2 tsx src/scripts/images.ts --iterations 11",
    "ec2:migrate": "DB_TARGET=ec2 tsx src/scripts/db.ts migrate",
    "ec2:seed": "DB_TARGET=ec2 tsx src/scripts/db.ts seed"
  },
  "keywords": [
    "sneaker",
    "price",
    "api",
    "scraper"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.991.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "https-proxy-agent": "^7.0.6",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.2",
    "pg": "^8.10.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.2.3",
    "puppeteer": "^24.36.1",
    "redis": "^4.6.0",
    "sharp": "^0.34.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.0",
    "@types/node-cron": "^3.0.8",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
