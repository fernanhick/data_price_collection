# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/sneaker_prices
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sneaker_prices
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Convex Configuration (for JWT validation)
CONVEX_URL=https://your-convex-deployment.convex.cloud
CONVEX_JWKS_URL=https://your-convex-deployment.convex.cloud/.well-known/jwks.json

# Convex Releases Ingest (push fan-out lives in Convex; the server POSTs new
# drops here after each release refresh).
#
# EVERY fully-configured target (URL + secret) is notified, not just the
# CONVEX_ENV-selected one. Set both the _DEV and _PROD pairs to fan drops out to
# both deployments at once — that's how you test pushes in a dev build while the
# live prod notifier keeps running. The plain CONVEX_RELEASES_INGEST_URL pair is
# a single-deployment fallback. At least one target is required in production:
# the app fails to start if none is configured.
CONVEX_RELEASES_INGEST_URL=https://your-convex-deployment.convex.site/releases/ingest
RELEASES_INGEST_SECRET=
# CONVEX_RELEASES_INGEST_URL_DEV=https://scrupulous-finch-579.convex.site/releases/ingest
# CONVEX_RELEASES_INGEST_URL_PROD=https://brave-dodo-157.convex.site/releases/ingest
# RELEASES_INGEST_SECRET_DEV=
# RELEASES_INGEST_SECRET_PROD=

# API Configuration
MAX_REQUESTS_PER_MINUTE=100
CACHE_TTL_SECONDS=7200

# Scraper Configuration
EBAY_BASE_URL=https://www.ebay.com
GOAT_BASE_URL=https://goat.com
REQUEST_TIMEOUT_MS=10000
RETRY_ATTEMPTS=3

# Optional: route StockX (Puppeteer) and GOAT (Algolia) requests through a proxy
# to reduce the risk of IP-based blocking. Leave unset to use the server's own IP.
# Format: http://username:password@host:port
SCRAPER_PROXY_URL=

# eBay Scraper Configuration
EBAY_CONDITION_CODES=1000,1500,3000,4000
EBAY_MIN_CONDITION=3000
EBAY_OUTLIER_FILTERING=true

# Price Validation
ENABLE_PRICE_THRESHOLD=false

# AWS S3 Image Storage (leave S3_BUCKET empty to use local filesystem)
S3_BUCKET=
S3_REGION=eu-north-1
CLOUDFRONT_URL=
# AWS credentials (set via aws configure or environment)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# StockX API (official v2 API)
# Get these from https://developer.stockx.com/portal/keys
STOCKX_CLIENT_ID=
STOCKX_CLIENT_SECRET=
STOCKX_API_KEY=
# Tokens are stored in the database after running OAuth via GET /api/auth/stockx

# Logging
LOG_LEVEL=info

# Scheduler
ENABLE_SCHEDULER=true
# All UTC. Heavy Chrome scrapers (tier 1/2/3) are spaced in the global
# pre-dawn lull so they never overlap; ECMV (internal calc) runs every 6h.
TIER_1_CRON=0 3 * * *
TIER_2_CRON=0 5 * * *
TIER_3_CRON=0 7 * * 1,4
# Every 3rd day at 04:00 UTC — see "Upcoming releases" below for why low cadence.
RELEASES_CRON=0 4 */3 * *
ECMV_CRON=0 0,6,12,18 * * *

# Upcoming releases (KicksDB GOAT feed — the only endpoint with a real
# release_date). Replaced the SoleRetriever HTML scrape, which only exposed ~1
# week. KicksDB's free tier is 1000 req/month shared with the catalog import, so
# the sync is bounded server-side to one date window (~2 requests/run) and runs
# every 3 days (~20/month).
# RELEASES_HORIZON_DAYS=90        # how far ahead to pull the calendar
# RELEASES_NOTIFY_MAX=25          # above this many new drops/run, suppress push (treat as backfill)
