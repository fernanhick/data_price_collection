# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/sneaker_prices
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sneaker_prices
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Convex Configuration (for JWT validation)
CONVEX_URL=https://your-convex-deployment.convex.cloud
CONVEX_JWKS_URL=https://your-convex-deployment.convex.cloud/.well-known/jwks.json

# API Configuration
MAX_REQUESTS_PER_MINUTE=100
CACHE_TTL_SECONDS=7200

# Scraper Configuration
EBAY_BASE_URL=https://www.ebay.com
GOAT_BASE_URL=https://goat.com
REQUEST_TIMEOUT_MS=10000
RETRY_ATTEMPTS=3

# eBay Scraper Configuration
EBAY_CONDITION_CODES=1000,1500,3000,4000
EBAY_MIN_CONDITION=3000
EBAY_OUTLIER_FILTERING=true

# Price Validation
ENABLE_PRICE_THRESHOLD=false

# AWS S3 Image Storage (leave S3_BUCKET empty to use local filesystem)
S3_BUCKET=
S3_REGION=eu-north-1
CLOUDFRONT_URL=
# AWS credentials (set via aws configure or environment)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Logging
LOG_LEVEL=info

# Scheduler
ENABLE_SCHEDULER=true
TIER_1_CRON=0 6,12,18,0 * * *
TIER_2_CRON=0 14 * * *
TIER_3_CRON=0 10 * * 1,4
